PORT=3000
# Path to CubiCasa5k-trained Mask R-CNN weights (primary segmentation pipeline; falls back to Claude Vision if absent)
CNN_WEIGHTS_PATH=weights/cubicasa5k_maskrcnn.onnx
ANTHROPIC_API_KEY=sk-ant-...
# Highest-tier Opus model id; verify against the Anthropic models docs
ANTHROPIC_MODEL=claude-opus-5-5
CORS_ORIGIN=http://localhost:5173
# Decoded image size limit in bytes (5 MB, Anthropic's per-image limit)
MAX_IMAGE_BYTES=5242880
